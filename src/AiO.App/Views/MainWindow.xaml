<Window x:Class="AiO.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiO" Width="1160" Height="800" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedPages" Source="{Binding Pages}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <!-- When maximised, Windows puts the frame off-screen; pad it back in. -->
    <Border x:Name="Root">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sidebar (spans the title bar so it reads as one surface) -->
            <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" />

            <!-- Title bar: app name over the sidebar -->
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="A" FontWeight="Bold" FontSize="12" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AiO" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Title bar: current page + caption buttons -->
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimise" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximise">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedPage.Title}" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="24,0,0,0" />
            </DockPanel>

            <!-- Navigation -->
            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version}" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" Margin="22,0,0,16" />
                <ListBox ItemsSource="{Binding Source={StaticResource GroupedPages}}" SelectedItem="{Binding SelectedPage}"
                         ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                         Margin="10,6,10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="12,14,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Page -->
            <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,18,36,24">
                <ContentControl x:Name="PageHost" Content="{Binding SelectedPage.Page}" MaxWidth="940"
                                RenderTransformOrigin="0.5,0">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>

            <!-- Status toast -->
            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Toast}" MaxWidth="640"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,22"
                    Visibility="{Binding Status, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentHoverBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="580" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
