<UserControl x:Class="AiO.App.Views.MousePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AiO.App.Controls">
    <StackPanel>
        <c:PageHeader Glyph="&#xE962;" Title="Mouse"
                      Subtitle="Raw mouse acceleration through RawAccel, plus Windows' own pointer settings." />

        <!-- RawAccel status -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE9D9;" Title="RawAccel" Subtitle="{Binding Status}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Download" Command="{Binding DownloadCommand}" Margin="0,0,8,0"
                                Visibility="{Binding FolderValid, Converter={StaticResource Hidden}}" />
                        <Button Content="Find" Command="{Binding DetectCommand}" Margin="0,0,8,0" />
                        <Button Content="Browse…" Command="{Binding BrowseCommand}" />
                    </StackPanel>
                </c:CardHeader>
                <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                           Visibility="{Binding Folder, Converter={StaticResource Visible}}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox Content="Re-apply when AiO starts (RawAccel forgets its curve on reboot)" IsChecked="{Binding ReapplyOnStartup}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Curve -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE9D2;" Title="Acceleration curve"
                              Subtitle="How sensitivity changes with mouse speed. Flat = no acceleration.">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,0" />
                        <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,8,0" />
                        <Button Content="Apply" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" />
                    </StackPanel>
                </c:CardHeader>

                <c:CurveGraph Points="{Binding Curve}" MaxX="100" Height="240" Margin="0,4,0,16" />

                <TextBlock Style="{StaticResource Warning}" Margin="0,0,0,12" Visibility="{Binding IsLut, Converter={StaticResource Visible}}"
                           Text="This RawAccel profile uses a look-up table, which AiO can't edit. Pick another style to replace it, or edit it in RawAccel's own app." />

                <WrapPanel Margin="0,0,0,8">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Style" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="170" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" Visibility="{Binding ShowCapMode, Converter={StaticResource Visible}}">
                        <TextBlock Text="Cap type" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CapModes}" SelectedItem="{Binding CapMode}" Width="130" />
                    </StackPanel>
                    <CheckBox Content="Gain (smoother; off = legacy velocity mode)" IsChecked="{Binding Gain}" VerticalAlignment="Bottom" Margin="0,0,0,12"
                              Visibility="{Binding ShowGain, Converter={StaticResource Visible}}" />
                </WrapPanel>

                <c:SliderRow Label="Sensitivity" Minimum="0.1" Maximum="5" Step="0.01" Format="{}{0:0.00}×" Value="{Binding Sensitivity}" />
                <c:SliderRow Label="Acceleration" Minimum="0.001" Maximum="0.5" Step="0.001" Format="{}{0:0.000}" Value="{Binding Acceleration}"
                             Visibility="{Binding ShowAcceleration, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Exponent" Minimum="1.1" Maximum="5" Step="0.05" Format="{}{0:0.00}" Value="{Binding ExponentClassic}"
                             Visibility="{Binding ShowExponentClassic, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Input offset" Minimum="0" Maximum="50" Step="0.5" Format="{}{0:0.0}" Value="{Binding InputOffset}"
                             Visibility="{Binding ShowInputOffset, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Output offset" Minimum="0" Maximum="5" Step="0.05" Format="{}{0:0.00}" Value="{Binding OutputOffset}"
                             Visibility="{Binding ShowOutputOffset, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Decay rate" Minimum="0.001" Maximum="1" Step="0.005" Format="{}{0:0.000}" Value="{Binding DecayRate}"
                             Visibility="{Binding ShowNatural, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Limit" Minimum="0.1" Maximum="5" Step="0.05" Format="{}{0:0.00}×" Value="{Binding Limit}"
                             Visibility="{Binding ShowNatural, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Scale" Minimum="0.01" Maximum="5" Step="0.01" Format="{}{0:0.00}" Value="{Binding Scale}"
                             Visibility="{Binding ShowPower, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Exponent" Minimum="0.01" Maximum="2" Step="0.01" Format="{}{0:0.00}" Value="{Binding ExponentPower}"
                             Visibility="{Binding ShowPowerExponent, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Sync speed" Minimum="0.5" Maximum="50" Step="0.5" Format="{}{0:0.0}" Value="{Binding SyncSpeed}"
                             Visibility="{Binding ShowSync, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Motivity" Minimum="1.01" Maximum="5" Step="0.01" Format="{}{0:0.00}" Value="{Binding Motivity}"
                             Visibility="{Binding ShowSync, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Gamma" Minimum="0.1" Maximum="5" Step="0.05" Format="{}{0:0.00}" Value="{Binding Gamma}"
                             Visibility="{Binding ShowSync, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="{Binding CapXLabel}" Minimum="0" Maximum="100" Step="0.5" Format="{}{0:0.0}" Value="{Binding CapX}"
                             Visibility="{Binding ShowCapX, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="{Binding CapYLabel}" Minimum="0" Maximum="5" Step="0.05" Format="{}{0:0.00}×" Value="{Binding CapY}"
                             Visibility="{Binding ShowCapY, Converter={StaticResource Visible}}" />
                <c:SliderRow Label="Smoothness" Minimum="0" Maximum="1" Step="0.05" Format="{}{0:0.00}" Value="{Binding Smooth}"
                             Visibility="{Binding ShowSmooth, Converter={StaticResource Visible}}" />

                <TextBlock Text="Advanced" FontWeight="SemiBold" Margin="0,16,0,6" />
                <c:SliderRow Label="Vertical ratio (Y/X)" Minimum="0.25" Maximum="4" Step="0.01" Format="{}{0:0.00}" Value="{Binding YxRatio}" />
                <c:SliderRow Label="Rotation" Minimum="-30" Maximum="30" Step="0.5" Format="{}{0:0.0}°" Value="{Binding Rotation}" />
                <c:SliderRow Label="Angle snapping" Minimum="0" Maximum="10" Step="0.5" Format="{}{0:0.0}°" Value="{Binding AngleSnap}" />

                <Button Content="Open RawAccel's own app" Command="{Binding OpenRawAccelCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"
                        Visibility="{Binding FolderValid, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>

        <!-- Windows pointer -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE7C9;" Title="Windows pointer" Subtitle="{Binding WindowsAdvice}">
                    <Button Content="Use recommended" Command="{Binding RecommendedWindowsCommand}" />
                </c:CardHeader>
                <c:SliderRow Label="Pointer speed" Minimum="1" Maximum="20" Format="{}{0:0} / 20" Value="{Binding PointerSpeed}" />
                <CheckBox Content="Enhance pointer precision (Windows acceleration)" IsChecked="{Binding EnhancePointerPrecision}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
