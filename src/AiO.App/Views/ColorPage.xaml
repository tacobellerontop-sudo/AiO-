<UserControl x:Class="AiO.App.Views.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AiO.App.Controls">
    <StackPanel>
        <c:PageHeader Glyph="&#xE790;" Title="Colour"
                      Subtitle="Three layers of colour control: the monitor itself (DDC/CI), the GPU driver (NVIDIA / AMD), and a software gamma ramp that works everywhere. AiO re-applies your settings each time it starts.">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" Width="260" />
                <Button Content="Refresh" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </c:PageHeader>

        <!-- Presets -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE790;" Title="Presets" Subtitle="{Binding ActivePresetText}" />
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="200" Margin="0,0,10,10">
                                <Button Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Apply to this display" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1.5" CornerRadius="10" Padding="12,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="22" Height="22" Fill="{Binding Swatch, Converter={StaticResource HexToBrush}}"
                                                 Stroke="{StaticResource BorderBrush}" StrokeThickness="1" VerticalAlignment="Center" />
                                        <StackPanel Margin="10,0,0,0" Width="130">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                                    <Button Content="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="10" Padding="5,3" BorderThickness="0" Background="Transparent"
                                            ToolTip="Apply to all displays"
                                            Command="{Binding DataContext.ApplyPresetToAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Padding="5,3" BorderThickness="0" Background="Transparent"
                                            ToolTip="Delete preset" Visibility="{Binding IsBuiltIn, Converter={StaticResource Hidden}}"
                                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Save current as preset" Style="{StaticResource AccentButton}"
                            Command="{Binding SavePresetCommand}" Margin="8,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Text="New preset" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <CheckBox Content="Include the monitor's brightness and contrast (DDC/CI)" IsChecked="{Binding IncludeMonitorInPreset}"
                          Margin="0,8,0,0" Visibility="{Binding HasDdc, Converter={StaticResource Visible}}" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                           Text="Tip: switch presets from the tray icon, or bind one to a shortcut on the Keyboard page." />
            </StackPanel>
        </Border>

        <!-- Monitor (DDC/CI) -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE7F8;" Title="Monitor (DDC/CI)" Subtitle="Changes the monitor's own settings, as if you used its buttons." />
                <TextBlock Text="Reading monitor…" Style="{StaticResource Muted}"
                           Visibility="{Binding DdcLoading, Converter={StaticResource Visible}}" />
                <TextBlock Style="{StaticResource Muted}" Visibility="{Binding ShowNoDdc, Converter={StaticResource Visible}}"
                           Text="This display doesn't answer DDC/CI. Built-in laptop panels and some TVs don't support it; on external monitors, check that DDC/CI is enabled in the monitor's menu." />
                <ItemsControl ItemsSource="{Binding DdcControls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SliderRow Label="{Binding Label}" Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasDdc, Converter={StaticResource Visible}}">
                    <TextBlock Text="Input source" Style="{StaticResource Label}" Width="150" />
                    <ComboBox ItemsSource="{Binding InputSources}" SelectedValuePath="Key" DisplayMemberPath="Value"
                              SelectedValue="{Binding SelectedInput}" Width="180" />
                    <Button Content="Switch" Command="{Binding ApplyInputCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- GPU driver -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE950;" Title="GPU colour" Subtitle="{Binding GpuVendorText}">
                    <Button Content="Reset" Command="{Binding ResetGpuCommand}"
                            Visibility="{Binding HasGpuControls, Converter={StaticResource Visible}}" />
                </c:CardHeader>
                <TextBlock Style="{StaticResource Muted}" Text="The GPU driver offers no colour controls for this display."
                           Visibility="{Binding HasGpuControls, Converter={StaticResource Hidden}}" />
                <ItemsControl ItemsSource="{Binding GpuProperties}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SliderRow Label="{Binding Label}" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Gamma ramp -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE706;" Title="Software colour"
                              Subtitle="Gamma-ramp adjustments that work on any GPU and monitor. Windows Night Light overrides these while it's on.">
                    <Button Content="Reset" Command="{Binding ResetGammaCommand}" />
                </c:CardHeader>
                <c:SliderRow Label="Colour temperature" Minimum="1900" Maximum="10000" Step="100" Format="{}{0:0} K" Value="{Binding Temperature}" />
                <c:SliderRow Label="Gamma" Minimum="0.5" Maximum="2.5" Step="0.05" Format="{}{0:0.00}" Value="{Binding GammaValue}" />
                <c:SliderRow Label="Brightness" Minimum="-50" Maximum="50" Format="{}{0:+0;-0;0}" Value="{Binding Brightness}" />
                <c:SliderRow Label="Contrast" Minimum="50" Maximum="150" Format="{}{0:0}%" Value="{Binding Contrast}" />
                <c:SliderRow Label="Red" Minimum="0" Maximum="100" Format="{}{0:0}%" Value="{Binding RedGain}" />
                <c:SliderRow Label="Green" Minimum="0" Maximum="100" Format="{}{0:0}%" Value="{Binding GreenGain}" />
                <c:SliderRow Label="Blue" Minimum="0" Maximum="100" Format="{}{0:0}%" Value="{Binding BlueGain}" />

                <DockPanel Margin="0,12,0,0" Visibility="{Binding FullRangeUnlocked, Converter={StaticResource Hidden}}">
                    <Button DockPanel.Dock="Right" Content="Unlock full range" Command="{Binding UnlockRangeCommand}" Margin="12,0,0,0" />
                    <TextBlock Style="{StaticResource Warning}" VerticalAlignment="Center"
                               Text="Windows limits how far the gamma ramp can move, so strong warm temperatures may be refused. Unlocking needs admin rights and a sign-out." />
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
