<UserControl x:Class="AiO.App.Views.DisplaysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AiO.App.Controls">
    <StackPanel>
        <c:PageHeader Glyph="&#xE7F4;" Title="Displays"
                      Subtitle="Resolution, refresh rate, orientation, scaling and HDR for each connected display. If the screen goes blank after a change, wait 15 seconds and it reverts.">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        </c:PageHeader>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE7F4;" Title="Quick settings" Subtitle="Built-in screen brightness and the Win+P projection mode." />
                <c:SliderRow Label="Built-in brightness" Minimum="0" Maximum="100" Format="{}{0:0}%" Value="{Binding PanelBrightness}"
                             Visibility="{Binding HasPanelBrightness, Converter={StaticResource Visible}}" Margin="0,0,0,8" />
                <TextBlock Text="Projection" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <WrapPanel>
                    <Button Content="PC screen only" Command="{Binding ProjectCommand}" CommandParameter="PcScreenOnly" Margin="0,0,8,8" />
                    <Button Content="Duplicate" Command="{Binding ProjectCommand}" CommandParameter="Duplicate" Margin="0,0,8,8" />
                    <Button Content="Extend" Command="{Binding ProjectCommand}" CommandParameter="Extend" Margin="0,0,8,8" />
                    <Button Content="Second screen only" Command="{Binding ProjectCommand}" CommandParameter="SecondScreenOnly" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Displays}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:CardHeader Glyph="&#xE7F4;" Title="{Binding Title}" Subtitle="{Binding Subtitle}" Margin="0,0,0,18" />

                            <WrapPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Resolution" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" Width="170" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Refresh rate" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding SelectedRefreshRate}" Width="120" ItemStringFormat="{}{0} Hz" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Orientation" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}" Width="160" />
                                </StackPanel>
                                <Button Content="Apply" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,12" />
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="Highest refresh rate" Command="{Binding RefreshPresetCommand}" CommandParameter="max" Margin="0,0,8,8" />
                                <Button Content="Lowest refresh rate" Command="{Binding RefreshPresetCommand}" CommandParameter="min" Margin="0,0,8,8"
                                        ToolTip="Saves battery on laptop screens" />
                                <Button Content="Make this my main display" Command="{Binding MakePrimaryCommand}" Margin="0,0,8,8"
                                        Visibility="{Binding CanMakePrimary, Converter={StaticResource Visible}}" />
                            </WrapPanel>

                            <WrapPanel Visibility="{Binding HasScale, Converter={StaticResource Visible}}">
                                <StackPanel Margin="0,0,16,12">
                                    <TextBlock Text="Scale" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" Width="120" ItemStringFormat="{}{0}%" />
                                </StackPanel>
                                <Button Content="Apply scale" Command="{Binding ApplyScaleCommand}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                            </WrapPanel>

                            <CheckBox Content="HDR" IsChecked="{Binding HdrEnabled, Mode=TwoWay}"
                                      Visibility="{Binding HdrSupported, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
