<UserControl x:Class="AiO.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Version, StringFormat=AiO {0}}" Style="{StaticResource PageSubtitle}" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Start-up" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                <CheckBox Content="Start minimised to the tray" IsChecked="{Binding StartMinimized}" />
                <CheckBox Content="Closing the window keeps AiO running in the tray" IsChecked="{Binding CloseToTray}" />
                <CheckBox Content="Re-apply colour and ASUS settings when AiO starts" IsChecked="{Binding ApplyOnStartup}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Permissions" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding AdminText}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" Margin="0,0,8,0" />
                    <Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Credits" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                           Text="AiO builds on hardware knowledge documented by these open-source projects. Use them directly if you need features AiO doesn't have yet." />
                <WrapPanel>
                    <Button Content="OpenRazer" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/openrazer/openrazer" Margin="0,0,8,8" />
                    <Button Content="OpenRGB" Command="{Binding OpenUrlCommand}" CommandParameter="https://openrgb.org" Margin="0,0,8,8" />
                    <Button Content="G-Helper" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/seerge/g-helper" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
