<UserControl x:Class="AiO.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AiO.App.Controls">
    <StackPanel>
        <c:PageHeader Glyph="&#xE713;" Title="Settings" Subtitle="{Binding Version, StringFormat=AiO {0}}" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE7E8;" Title="Start-up" />
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                <CheckBox Content="Start minimised to the tray" IsChecked="{Binding StartMinimized}" />
                <CheckBox Content="Closing the window keeps AiO running in the tray" IsChecked="{Binding CloseToTray}" />
                <CheckBox Content="Re-apply colour and ASUS settings when AiO starts" IsChecked="{Binding ApplyOnStartup}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE895;" Title="Updates" Subtitle="{Binding Updates.CurrentBuildText}" />
                <TextBlock Text="{Binding Updates.Status}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <ProgressBar Height="4" Margin="0,0,0,10" Maximum="100" Value="{Binding Updates.Progress}"
                             Visibility="{Binding Updates.IsBusy, Converter={StaticResource Visible}}" />
                <WrapPanel>
                    <Button Content="Check for updates" Command="{Binding Updates.CheckCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding Updates.InstallText}" Command="{Binding Updates.InstallCommand}" Margin="0,0,8,8"
                            Style="{StaticResource AccentButton}"
                            Visibility="{Binding Updates.IsAvailable, Converter={StaticResource Visible}}" />
                    <Button Content="Release page" Command="{Binding Updates.OpenReleasesCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <CheckBox Content="Check for updates when AiO starts" IsChecked="{Binding CheckForUpdates}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE72E;" Title="Permissions" Subtitle="{Binding AdminText}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" Margin="0,0,8,0" />
                    <Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Glyph="&#xE8E1;" Title="Credits"
                              Subtitle="AiO builds on hardware knowledge documented by these open-source projects. Use them directly if you need features AiO doesn't have yet." />
                <WrapPanel>
                    <Button Content="OpenRazer" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/openrazer/openrazer" Margin="0,0,8,8" />
                    <Button Content="G-Helper" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/seerge/g-helper" Margin="0,0,8,8" />
                    <Button Content="RawAccel" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/a1xd/rawaccel" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
