<UserControl x:Class="AiO.App.Views.AsusUnavailablePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="ASUS · G-Helper" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="G-Helper-style controls for ASUS laptops, without Armoury Crate." />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Controls not available on this PC" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding Machine}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,16" />
                <WrapPanel>
                    <Button Content="Check again" Command="{Binding CheckAgainCommand}" Margin="0,0,8,8" />
                    <Button Content="Restart AiO" Style="{StaticResource AccentButton}" Command="{Binding RestartAppCommand}" Margin="0,0,8,8"
                            Visibility="{Binding FoundNow, Converter={StaticResource Visible}}" />
                    <Button Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" Margin="0,0,8,8"
                            Visibility="{Binding CanElevate, Converter={StaticResource Visible}}" />
                    <Button Content="ASUS driver downloads" Command="{Binding OpenSupportCommand}" Margin="0,0,8,8"
                            Visibility="{Binding IsAsus, Converter={StaticResource Visible}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="What this page does on supported laptops" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Muted}" LineHeight="22" TextWrapping="Wrap">
                    • Performance modes: Silent, Balanced, Turbo (and the matching Windows power mode)<LineBreak />
                    • GPU modes: Eco (dGPU off), Standard (Optimus), Ultimate (MUX)<LineBreak />
                    • Live CPU/GPU temperatures and fan speeds<LineBreak />
                    • Custom fan curves for each mode<LineBreak />
                    • CPU power limits (SPL, sPPT, fPPT), GPU dynamic boost and temperature target<LineBreak />
                    • Battery charge limit (e.g. 80% to extend battery life)<LineBreak />
                    • Panel overdrive<LineBreak />
                    • Keyboard backlight brightness and Aura effects<LineBreak />
                    • Quick mode switching from the tray icon
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
